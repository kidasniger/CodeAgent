<?xml version="1.0" encoding="utf-8"?>
<!-- Exclut les préférences chiffrées (clé API) : la clé de chiffrement Keystore
     n'est pas restaurée sur un autre appareil, ce qui provoquait un crash. -->
<full-backup-content>
    <exclude domain="sharedpref" path="zagent_secure_prefs.xml"/>
    <exclude domain="file" path="conversations"/>
    <exclude domain="file" path="usage"/>
    <exclude domain="file" path="activity"/>
    <!-- err-085 : les caches (APK téléchargés, exports zip, crash logs)
         ne sont ni utiles ni sensibles à sauvegarder. -->
    <exclude domain="external" path="cache"/>
    <exclude domain="file" path="crash"/>
</full-backup-content>
