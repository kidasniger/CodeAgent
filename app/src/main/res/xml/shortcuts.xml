<?xml version="1.0" encoding="utf-8"?>
<!-- MA39 : raccourcis mis à jour — Git et Modèles rejoignent Nouvelle
     conversation et Terminal (4 raccourcis maximum). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="new_chat"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutShortLabel="@string/shortcut_new_chat"
        android:shortcutLongLabel="@string/shortcut_new_chat_long">
        <intent
            android:action="com.zagent.app.action.NEW_CHAT"
            android:targetPackage="com.zagent"
            android:targetClass="com.zagent.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_terminal"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_terminal"
        android:shortcutShortLabel="@string/shortcut_open_terminal"
        android:shortcutLongLabel="@string/shortcut_open_terminal_long">
        <intent
            android:action="com.zagent.app.action.OPEN_TERMINAL"
            android:targetPackage="com.zagent"
            android:targetClass="com.zagent.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_git"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_folder"
        android:shortcutShortLabel="@string/shortcut_git"
        android:shortcutLongLabel="@string/shortcut_git_long">
        <intent
            android:action="com.zagent.app.action.OPEN_GIT"
            android:targetPackage="com.zagent"
            android:targetClass="com.zagent.app.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_models"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_chat"
        android:shortcutShortLabel="@string/shortcut_models"
        android:shortcutLongLabel="@string/shortcut_models_long">
        <intent
            android:action="com.zagent.app.action.OPEN_MODELS"
            android:targetPackage="com.zagent"
            android:targetClass="com.zagent.app.MainActivity" />
    </shortcut>
</shortcuts>
