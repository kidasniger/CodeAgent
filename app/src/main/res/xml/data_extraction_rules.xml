<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- corr-024 : le chiffrement local ne protège pas une sauvegarde cloud —
         les clés API ET les conversations (contenu privé du projet) restent
         hors des sauvegardes. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="zagent_secure_prefs.xml"/>
        <exclude domain="file" path="conversations"/>
        <exclude domain="file" path="usage"/>
        <exclude domain="file" path="activity"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="zagent_secure_prefs.xml"/>
        <exclude domain="file" path="conversations"/>
        <exclude domain="file" path="usage"/>
        <exclude domain="file" path="activity"/>
    </device-transfer>
</data-extraction-rules>
