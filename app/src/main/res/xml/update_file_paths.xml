<?xml version="1.0" encoding="utf-8"?>
<!-- maj-076 : ce provider ne sert plus qu'à l'installation des APK
     téléchargés par UpdateManager (cache/updates/). Le partage des fichiers
     du projet est passé sur un provider dédié (@xml/file_share_paths,
     authority .fileshareprovider) : le scope ici est réduit au seul dossier
     des APK. Ne pas y ajouter la racine du stockage ni les fichiers projet. -->
<paths>
    <cache-path name="updates" path="updates/" />
</paths>
